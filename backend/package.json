{
  "name": "vortex-backend",
  "version": "1.0.0",
  "description": "Vortex Athletics Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "prestart": "npm run migrate:deploy",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:migrations:postgres": "node --test --test-concurrency=1 platform/__tests__/deployMigrations.postgres.test.js",
    "check:email-auth": "node scripts/check-email-domain-authentication.mjs",
    "seed-events": "node seed-events.js",
    "seed:dev-members": "node members/runSeedDevMembers.js",
    "seed:local-scheduling": "node scripts/seed-local-scheduling.mjs",
    "migrate": "node run-migration.js",
    "migrate:all": "node run-migration.js --all",
    "migrate:deploy": "node scripts/run-deploy-migrations.mjs",
    "repair:needs-engine-schema": "node scripts/repair-needs-engine-schema.mjs",
    "repair:boot-constraints": "node -e \"import pg from 'pg'; import dotenv from 'dotenv'; import { ensureCoachingBootConstraints } from './platform/ensureCoachingBootConstraints.js'; dotenv.config({path:'.env.local'}); const cs=process.env.EXTERNAL_DB_URL||process.env.DB_URL; const p=new pg.Pool({connectionString:cs,ssl:{rejectUnauthorized:false}}); await ensureCoachingBootConstraints(p); await p.end(); console.log('done');\"",
    "repair:failed-seeds": "node scripts/repair-failed-seed-migrations.mjs",
    "audit:boot-migrations": "node scripts/audit-boot-migration-failures.mjs",
    "audit:canonical-library": "node scripts/audit-canonical-exercise-library.mjs",
    "audit:needs-engine-library": "node scripts/audit-needs-engine-exercise-library.mjs",
    "check:canonical-release": "node scripts/check-canonical-release-readiness.mjs",
    "report:canonical-identity-queue": "node scripts/report-canonical-identity-queue.mjs",
    "report:canonical-structured-profile-queue": "node scripts/report-canonical-structured-profile-queue.mjs",
    "export:canonical-research-queue": "node scripts/export-canonical-research-queue.mjs",
    "import:canonical-research": "node scripts/import-canonical-research-packet.mjs",
    "discover:canonical-youtube": "node scripts/discover-canonical-youtube-candidates.mjs",
    "hydrate:canonical-youtube-oembed": "node scripts/hydrate-canonical-youtube-oembed.mjs",
    "build:canonical-research-batch": "node scripts/build-canonical-research-batch.mjs",
    "normalize:canonical-research-difficulty": "node scripts/normalize-canonical-research-difficulty.mjs",
    "eval:prescription": "node ../scripts/evaluate-prescription-quality.mjs",
    "sync:golden-requirements": "node ../scripts/sync-golden-from-saved-requirements.mjs \"Test 3 - Reqs only\"",
    "billing:recurring": "node scheduling/runRecurringCharges.js",
    "billing:repair-autopay": "node scripts/repair-enrollment-auto-pay.mjs",
    "billing:audit-family-discounts": "node scripts/audit-family-discounts.mjs",
    "billing:subscription-checkouts:audit": "node scripts/manage-stale-subscription-checkout-sessions.mjs",
    "billing:repair-membership-allocation": "node scripts/repair-membership-payment-allocation.mjs",
    "billing:repair-recurring-periods": "node scripts/repair-recurring-charge-service-periods.mjs",
    "billing:repair-initial-proration": "node scripts/repair-initial-enrollment-proration.mjs",
    "billing:repair-late-start-enrollments": "node scripts/repair-late-start-enrollment-billing.mjs",
    "billing:repair-duplicate-invoice-payments": "node scripts/repair-duplicate-stripe-invoice-payments.mjs",
    "billing:migration:audit": "node scripts/audit-canonical-billing-migration.mjs",
    "billing:migration:repair": "node scripts/repair-canonical-billing-migration.mjs",
    "billing:migration:repair-waived-memberships": "node scripts/repair-waived-memberships-canonical-billing.mjs",
    "billing:migration:prepare": "node scripts/prepare-canonical-billing-migration.mjs",
    "billing:migration:adopt": "node scripts/adopt-canonical-billing-migration.mjs",
    "billing:migration:advance": "node scripts/advance-canonical-billing-migration.mjs",
    "billing:migration:verify": "node scripts/verify-canonical-billing-migration.mjs",
    "billing:migration:rollback": "node scripts/rollback-canonical-billing-migration.mjs",
    "billing:migration:supersede-audit": "node scripts/supersede-canonical-billing-migration-audit.mjs",
    "billing:retirement:audit": "node scripts/audit-billing-legacy-retirement.mjs",
    "billing:retirement:heartbeat": "node scripts/record-billing-legacy-telemetry-heartbeat.mjs",
    "billing:retirement:verify-cycle": "node scripts/verify-billing-retirement-cycle.mjs",
    "roster:daily": "node scheduling/runDailyRoster.js",
    "stripe:sync-catalog": "node billing/runStripeCatalogSync.js",
    "stripe:reconcile": "node billing/runStripeReconciliation.js",
    "bootstrap:staging-rehearsal": "node scripts/bootstrap-staging-rehearsal-accounts.mjs",
    "verify:module0": "node verify-module0.js",
    "list-tables": "DB_HOST=localhost DB_PORT=5432 DB_NAME=vortex_athletics DB_USER=postgres DB_PASSWORD=vortex2024 node list-all-tables.js",
    "postinstall": "echo 'Backend dependencies installed'"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.73",
    "ai": "^6.0.208",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.3",
    "stripe": "^22.3.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
