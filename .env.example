VITE_API_URL=http://localhost:3001
VITE_CDN_BASE_URL=
VITE_CDN_PRECONNECT=
VITE_EXTERNAL_PAYMENT_PROCESSOR_NAME=External Payment Processor

# Server-only AI support. Keep this out of VITE_* variables.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPPORTUNITY_AI_HOURLY_LIMIT=20

# Server-only API database limits. Four connections allow nested billing work
# while bounding concurrent query memory on the small production database.
# DB_POOL_MAX=4
# DB_CONNECT_TIMEOUT_MS=3000
# DB_JIT_ENABLED=false

# Server-only Stripe Terminal. Map each Vortex facility ID to its Stripe location.
# STRIPE_TERMINAL_ENABLED=false
# STRIPE_TERMINAL_LOCATIONS={"1":"tml_REPLACE_ME"}
